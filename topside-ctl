#!/bin/zsh
# Drive the running Topside app from the command line.
#   ./topside-ctl open            open the notch (pinned)
#   ./topside-ctl open:shelf      open a tab: home today shelf clipboard timer mirror devices prompter agents
#   ./topside-ctl close
#   ./topside-ctl settings
#   ./topside-ctl shelf:/path/to/file   add a file to the tray
#   ./topside-ctl timer:300             start a timer (seconds); stoptimer cancels
#   ./topside-ctl "toast:Build finished"
#   ./topside-ctl media:play            play/pause; media:next and media:previous skip
#   ./topside-ctl "playlist:study vibes"   play a Music playlist; shuffle: shuffles it
#   ./topside-ctl playlists               open the playlist browser in the notch
#   ./topside-ctl "queue:study vibes|Nocturnal"   queue one track; clearqueue empties it
exec /usr/bin/osascript -l JavaScript -e 'function run(a){ObjC.import("Foundation");$.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately("local.topside.control",a[0],$(),true)}' "${1:-open}"
